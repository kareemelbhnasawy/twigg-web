# Copy to .env.local and fill in. .env.local is git-ignored.

# Google Maps JavaScript API key — enables the interactive map (tap hubs to pick start/destination,
# real road route + distance). Enable "Maps JavaScript API" (and "Routes API" for road routes)
# on the key, and restrict it to your domains (HTTP referrers).
# Without a key, the app still shows a real Google map preview of the chosen route.
VITE_GOOGLE_MAPS_API_KEY=

# Optional: a Map ID from Google Cloud (needed for Advanced Markers). Defaults to Google's DEMO_MAP_ID.
VITE_GOOGLE_MAPS_MAP_ID=
